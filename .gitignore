# =============================================================================
# design-patterns — .gitignore for C#/.NET, TypeScript/React (Node + Vite),
# Python and Go, plus common editors and operating systems.
# =============================================================================

# -----------------------------------------------------------------------------
# C# / .NET
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Ll]og/
[Ll]ogs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs
*.rsuser
.vs/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
artifacts/
TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/
*.pdb
*.dll.config
launchSettings.json

# -----------------------------------------------------------------------------
# Node.js / TypeScript / React / Vite
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
.nyc_output/
*.local

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
.installed.cfg
.venv/
venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Go
# -----------------------------------------------------------------------------
# Compiled binaries (each example is run with `go run`, so nothing should be built in-tree)
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
go.work
go.work.sum
/vendor/
cover.out
coverage.out

# -----------------------------------------------------------------------------
# Environment and secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.sublime-workspace
*.swp
*.swo
*~
.history/
.fleet/

# -----------------------------------------------------------------------------
# Operating systems
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
